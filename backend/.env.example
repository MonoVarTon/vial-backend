# Vial backend — переменные окружения
# Скопируйте этот файл в .env и впишите реальные значения САМИ.
# .env никогда не коммитить и не пересылать никому, включая Claude.

# Токен бота из @BotFather (после /revoke — новый)
BOT_TOKEN=

# Кошелёк бэкенда для минта (testnet на старте)
TON_MNEMONIC=
NFT_WALLET_SEED_ENCRYPTED=
NFT_SEED_KEY=

# IPFS / Pinata
PINATA_JWT=

# Адреса наших контрактов (заполнится после деплоя в testnet)
VAULT_CONTRACT_ADDRESS=
CONTROLLER_CONTRACT_ADDRESS=
COLLECTION_CONTRACT_ADDRESS=
